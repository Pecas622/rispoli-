generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  STUDENT
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  dni           String?
  passwordHash  String?  @map("password_hash")
  role          Role     @default(STUDENT)
  avatar        String?
  emailVerified Boolean  @default(false) @map("email_verified")
  isBlocked     Boolean  @default(false) @map("is_blocked")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enrollments Enrollment[]
  progress    LessonProgress[]
  passwordResetTokens PasswordResetToken[]
  reviews     Review[]
  questions   Question[]
  answers     Answer[]

  @@map("users")
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("verification_codes")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Course {
  id            String   @id @default(cuid())
  title         String
  subtitle      String?
  description   String?  @db.Text
  category      String
  level         String
  modality      String   @default("Online")
  duration      String?
  hours         Int?
  price            Float                     // ARS — precio en pesos argentinos
  originalPrice    Float?   @map("original_price")
  priceUSD         Float?   @map("price_usd")
  originalPriceUSD Float?   @map("original_price_usd")
  rating        Float    @default(0)
  reviews       Int      @default(0)
  students      Int      @default(0)
  image         String?
  previewVideo  String?  @map("preview_video")
  featured      Boolean  @default(false)
  stripePriceId String?  @map("stripe_price_id")
  published     Boolean  @default(true)
  tags             String[]
  requirements     String[]
  includes         String[]
  transferCode     String?  @map("transfer_code") // cupón de 10% off pagando por transferencia (ej. "TRANSFER10")
  certifiedBy      String?  @map("certified_by") // entidad que avala el certificado (default: Go Travel Academy)
  learningObjectives String[] @map("learning_objectives")
  targetAudience     String[] @map("target_audience")
  instructorName   String?  @map("instructor_name")
  instructorRole   String?  @map("instructor_role")
  instructorAvatar String?  @map("instructor_avatar")
  instructorBio    String?  @map("instructor_bio") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  modules       Module[]
  enrollments   Enrollment[]
  courseReviews Review[]

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String   @map("module_id")
  title       String
  description String?  @db.Text
  duration    String?
  videoType   String?  @map("video_type")   // youtube | vimeo | upload | url | none
  videoUrl    String?  @map("video_url")
  contentType String?  @map("content_type") // video | text | both
  content     String?  @db.Text             // contenido de texto de la clase
  isPreview   Boolean  @default(false) @map("is_preview")
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources Resource[]
  progress  LessonProgress[]
  questions Question[]

  @@map("lessons")
}

// Foro de preguntas por clase: pregunta y respuestas públicas para todos los
// alumnos inscriptos en el curso (no solo entre el alumno y el instructor).
model Question {
  id        String   @id @default(cuid())
  lessonId  String   @map("lesson_id")
  userId    String   @map("user_id")
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lesson  Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([lessonId])
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

model Resource {
  id       String  @id @default(cuid())
  lessonId String  @map("lesson_id")
  name     String
  type     String
  size     String?
  url      String?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model Enrollment {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  courseId              String    @map("course_id")
  stripeSessionId       String?   @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  mpPaymentId           String?   @map("mp_payment_id")
  paymentProvider       String?   @map("payment_provider") // stripe | mercadopago | free
  paidAt                DateTime? @map("paid_at")
  // Reembolso o contracargo: revoca el acceso sin borrar el registro de la
  // venta (queda para el historial de pagos del admin).
  refundedAt            DateTime? @map("refunded_at")
  // Vencimiento del acceso (6 meses desde la compra) para las inscripciones
  // nuevas. Null = acceso de por vida — así quedan las compras viejas, que se
  // vendieron con esa promesa y no se les puede cambiar la condición.
  expiresAt             DateTime? @map("expires_at")
  amount                Float?
  currency              String?   @default("ARS")
  // Cuotas elegidas por el comprador en Mercado Pago (1 = pago único). Stripe
  // y las cargas gratis no manejan cuotas, quedan en null.
  installments          Int?
  // Se saca del total recaudado/promedio del panel sin tocar el acceso del
  // alumno — para cargas de prueba o datos que no son ventas reales.
  excludeFromStats      Boolean   @default(false) @map("exclude_from_stats")
  createdAt             DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  installmentPayments Installment[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

// Estado real de cada cuota de un pago financiado (a diferencia de
// Enrollment.installments, que es solo la cantidad elegida). Mercado Pago no
// le avisa a Rispoli cuándo el comprador le paga cada cuota a su banco —eso
// pasa entre el comprador y su tarjeta—, así que el admin marca acá a mano
// cuál está paga y cuál no. Se generan como sugerencia al aprobarse el pago
// (monto dividido, vencimiento mensual) pero el admin las edita libremente.
model Installment {
  id           String    @id @default(cuid())
  enrollmentId String    @map("enrollment_id")
  number       Int
  amount       Float
  dueDate      DateTime? @map("due_date")
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, number])
  @@map("installments")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  courseId  String   @map("course_id")
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("reviews")
}
