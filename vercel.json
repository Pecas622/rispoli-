{
      "routes": [
              { "src": "/sitemap.xml", "dest": "/api/sitemap" },
              { "handle": "filesystem" },
              { "src": "/api/(.*)", "dest": "https://rispoli-backend-production.up.railway.app/api/$1" },
              { "src": "^/$", "dest": "/index.html" },
              { "src": "^/(cursos(/[^/]+)?|dashboard|admin(/courses/[^/]+/content)?|instructor|reset-password|certificaciones|descargas|pagos|perfil|empresas|nosotros|blog|contacto)/?$", "dest": "/index.html" },
              { "src": "/(.*)", "status": 404, "dest": "/index.html" }
      ]
}
