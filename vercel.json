{
      "routes": [
              { "src": "/sitemap.xml", "dest": "/api/sitemap" },
              {
                "src": "/(.*)",
                "headers": {
                  "X-Frame-Options": "SAMEORIGIN",
                  "X-Content-Type-Options": "nosniff",
                  "Referrer-Policy": "strict-origin-when-cross-origin",
                  "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
                },
                "continue": true
              },
              { "handle": "filesystem" },
              { "src": "/api/(.*)", "dest": "https://rispoli-backend-production.up.railway.app/api/$1" },
              { "src": "^/$", "dest": "/index.html" },
              { "src": "^/(cursos(/[^/]+)?|dashboard|admin(/courses/[^/]+/content)?|instructor|reset-password|certificaciones|descargas|pagos|perfil|empresas|nosotros|blog|contacto|privacidad|terminos|cookies)/?$", "dest": "/index.html" },
              { "src": "/(.*)", "status": 404, "dest": "/index.html" }
      ]
}
